# Copy to .env (gitignored) and fill in. Never commit real values.

# Cloudflare API token: Zone > DNS > Edit, zone rooday.com only.
# Used by Traefik for DNS-01 certificates.
CF_DNS_API_TOKEN=
# Let's Encrypt account email.
ACME_EMAIL=
# librespeed results/statistics password.
LIBRESPEED_PASSWORD=
