{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/New_York",
  "schedule": ["at any time"],
  "prHourlyLimit": 0,
  "dependencyDashboard": true,
  "docker-compose": {
    "managerFilePatterns": ["/^(?:engager|intimidator|proxy-west|proxy-east)\\/.*\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Docker tags usually have no release timestamp; do not park updates as pending.",
      "matchDatasources": ["docker"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "LinuxServer tags: upstream version (3 or 4 parts), optional commit, then -lsNNN rebuild number.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/**"],
      "matchCurrentValue": "/-ls\\d+$/",
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?(?:[-_][a-zA-Z0-9.]+)*-ls(?<revision>\\d+)$"
    },
    {
      "description": "faster-whisper publishes gpu-legacy- prefixed builds that the generic LinuxServer regex does not match.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/faster-whisper"],
      "versioning": "regex:^gpu-legacy-v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<revision>\\d+)$"
    },
    {
      "description": "calibre-web has a legacy v5.x-ls1 tag line from 2020 that would otherwise look like a major upgrade; only the bare 0.x-lsNNN line is current.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/calibre-web"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<revision>\\d+)$"
    },
    {
      "description": "immich-machine-learning ships the same release as the server with a -cuda suffix.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/immich-app/immich-machine-learning"],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-cuda$"
    },
    {
      "description": "qbittorrent publishes a bare upstream version; a single-digit major excludes legacy 20.04.x tags.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/qbittorrent"],
      "versioning": "regex:^v?(?<major>\\d)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Gramps Web uses CalVer with mixed v-prefixed and bare tags, plus the occasional 4-part build.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/gramps-project/grampsweb"],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?$"
    },
    {
      "description": "Upstream publishes only :latest for these; the digest pin makes updates reviewable in git.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["imjacobclark/cors-container", "bsyed/troddit"],
      "pinDigests": true
    },
    {
      "description": "traefik and traefik-ts run the same image; move them in one PR.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["traefik"],
      "groupName": "traefik"
    },
    {
      "description": "Ingress must never auto-merge.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["traefik", "tailscale/tailscale"],
      "automerge": false
    },
    {
      "description": "Immich server and machine-learning ship one release and must stay on the same version.",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "groupName": "immich"
    },
    {
      "description": "Immich postgres is a custom VectorChord image; PG16 changes only via a deliberate dump/restore.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/immich-app/postgres"],
      "enabled": false
    },
    {
      "description": "Postgres stays on major 16 until a deliberate migration; patch/minor PRs still land.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres", "docker.io/library/postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "MySQL stays on 8.4 LTS; 9.x and 26.x need a deliberate one-way data dictionary migration.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mysql", "docker.io/library/mysql"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Immich valkey is pinned to the cache version that Immich release was tested against.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["valkey/valkey", "docker.io/valkey/valkey"],
      "matchFileNames": ["intimidator/immich.yaml"],
      "enabled": false
    },
    {
      "description": "Low-risk apps: automerge minor/patch/digest updates once 3 days old, committed straight to main. Opt-in list so new images stay manual.",
      "matchDatasources": ["docker"],
      "matchFileNames": ["engager/**", "intimidator/**"],
      "matchPackageNames": [
        "lscr.io/linuxserver/sonarr", "lscr.io/linuxserver/radarr", "lscr.io/linuxserver/lidarr",
        "lscr.io/linuxserver/prowlarr", "lscr.io/linuxserver/bazarr", "lscr.io/linuxserver/tautulli",
        "lscr.io/linuxserver/librespeed", "lscr.io/linuxserver/calibre", "lscr.io/linuxserver/calibre-web",
        "lscr.io/linuxserver/piper", "lscr.io/linuxserver/plex",
        "ghcr.io/recyclarr/recyclarr", "kometateam/kometa", "ghcr.io/cleanuparr/cleanuparr",
        "ghcr.io/flaresolverr/flaresolverr", "nicolargo/glances", "ghcr.io/analogj/scrutiny",
        "timothyjmiller/cloudflare-ddns", "ghcr.io/journeydocker/plex-auto-languages", "thomst08/requestrr",
        "ghcr.io/chrisae9/synclounge", "curlimages/curl",
        "bsyed/troddit", "imjacobclark/cors-container"
      ],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Stateful or networked apps: automerge patch releases only, once 3 days old. Minor and major stay as PRs.",
      "matchDatasources": ["docker"],
      "matchFileNames": ["engager/**", "intimidator/**"],
      "matchPackageNames": [
        "qmcgaw/gluetun", "lscr.io/linuxserver/qbittorrent", "grafana/grafana", "influxdb",
        "coturn/coturn", "nginx", "docker.io/library/redis", "docker.io/actualbudget/actual-server",
        "vabene1111/recipes", "ghcr.io/gramps-project/grampsweb", "matrixdotorg/synapse", "ghost",
        "ghcr.io/immich-app/immich-server", "ghcr.io/immich-app/immich-machine-learning",
        "mysql", "docker.io/library/mysql"
      ],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Postgres minor releases (16.15 -> 16.16) are its bug-fix releases; automerge them within major 16.",
      "matchDatasources": ["docker"],
      "matchFileNames": ["engager/**", "intimidator/**"],
      "matchPackageNames": ["postgres", "docker.io/library/postgres"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "minimumReleaseAge": "3 days"
    }
  ]
}
