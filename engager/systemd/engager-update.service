[Unit]
Description=Engager deploy (fetch git, pull images, recreate changed containers)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/rooday/docker-compose/engager
RuntimeDirectory=engager-updater
RuntimeDirectoryMode=0755
ExecStart=/usr/local/lib/engager-updater/update-containers.sh
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
