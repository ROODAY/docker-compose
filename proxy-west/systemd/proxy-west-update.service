[Unit]
Description=proxy-west deploy (fetch git, pull images, recreate changed containers)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
OnFailure=proxy-west-update-notify.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/rooday/docker-compose/proxy-west
RuntimeDirectory=proxy-west-updater
RuntimeDirectoryMode=0755
ExecStart=/usr/local/lib/proxy-west-updater/update-containers.sh
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
